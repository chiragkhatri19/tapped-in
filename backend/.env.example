# Copy to .env and fill in values. Never commit .env.

# Supabase — get from supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key (NOT anon key — has full DB access)
SUPABASE_ANON_KEY=eyJ...           # anon/public key — used for RLS-scoped writes made AS the user

# Google Gemini — aistudio.google.com
GEMINI_API_KEY=AIza...

# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,https://your-expo-app-url.com
