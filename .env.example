# Copy to .env — never commit .env

# Supabase — supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...      # anon/public key (safe to expose)

# Railway backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3000   # → your Railway URL in production

# NOTE: There is intentionally no EXPO_PUBLIC_GEMINI_API_KEY here. EXPO_PUBLIC_*
# values are inlined into the app bundle and are extractable from the shipped APK.
# All Gemini calls (scan, coach, workout) go through the authenticated backend,
# which holds GEMINI_API_KEY server-side. Never put a Gemini key in the mobile app.
