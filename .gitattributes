# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Shell scripts must stay LF (they run on Linux CI / Railway).
*.sh text eol=lf

# Windows batch files stay CRLF.
*.bat text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.docx binary
*.apk binary
